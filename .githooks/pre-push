#!/bin/sh
# pre-push — adws-pipeline-skill local CI gate. Blocks the push if the local CI fails.
#
# Cloud CodeQL is billing-locked account-wide, so this hook IS the gate. It runs Tier 1
# (host, seconds) then Tier 2 (OrbStack clean-room, Node 20/24 — closes the F-13 blind
# spot). Bypass with `git push --no-verify`. Wired via core.hooksPath=.githooks; run once
# per clone: `make install-hooks`. Tier 3 (`make review`) is advisory and run separately.
set -e

echo "[pre-push] Tier 1 — host gate (parity 93/19/7 + static + lints)..."
/usr/bin/env bash scripts/local-ci/gate.sh

echo "[pre-push] Tier 2 — OrbStack clean-room (Node 20/24)..."
/usr/bin/env bash scripts/local-ci/orb-ci.sh

echo "[pre-push] local CI passed."
